{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022"]
  },
  "include": ["api", "src", "scripts"],
  "exclude": ["node_modules", "scripts/spike-aave.ts"]
}
