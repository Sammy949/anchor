# Optional: override the default public Base mainnet RPC with a private endpoint
# (Alchemy, Infura, QuickNode, etc.) to reduce rate-limit / reliability risk.
# If unset, Anchor uses https://mainnet.base.org.
# ANCHOR_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>

# Required for the knowledge path (FRAUD_DETECTION questions with no wallet, e.g.
# "What characterized the BitConnect Ponzi scheme?"). Without it, wallet risk
# checks still work, but knowledge questions return HTTP 503. Set in Vercel too.
# GROQ_API_KEY=gsk_<key>

# Optional knowledge-path overrides (sensible defaults shown):
# ANCHOR_LLM_MODEL=llama-3.3-70b-versatile
# ANCHOR_LLM_TIMEOUT_MS=8000
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
