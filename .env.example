# PRIMARY Base-mainnet RPC for the wallet-analysis path. Set this to a private
# free-tier endpoint (Alchemy / Infura / QuickNode) so a live validator
# spot-check never hits the public RPC's rate limits or cold-start latency.
# Set it in Vercel (Project -> Settings -> Environment Variables); do NOT commit
# it. If unset, Anchor falls back to the public RPC alone.
#   Alchemy: https://base-mainnet.g.alchemy.com/v2/<key>
#   Infura:  https://base-mainnet.infura.io/v3/<key>
# ANCHOR_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>

# The public Base RPC (https://mainnet.base.org) is ALWAYS kept as an automatic
# fallback if ANCHOR_RPC_URL fails or times out, so there's no single point of
# failure. Per-endpoint read timeout in ms before failing over (default 4000).
# ANCHOR_RPC_TIMEOUT_MS=4000

# Required for the knowledge path (FRAUD_DETECTION questions with no wallet, e.g.
# "What characterized the BitConnect Ponzi scheme?"). Without it, wallet risk
# checks still work, but knowledge questions return HTTP 503. Set in Vercel too.
# GROQ_API_KEY=gsk_<key>

# Optional knowledge-path overrides (sensible defaults shown):
# ANCHOR_LLM_MODEL=llama-3.3-70b-versatile
# ANCHOR_LLM_TIMEOUT_MS=8000
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
